# Скопируйте в .env для локального запуска. На Vercel задайте те же переменные в Settings → Environment Variables.
DATABASE_URL=postgresql://user:password@localhost:5432/liquidity_db
SECRET_KEY=замените-на-длинную-случайную-строку
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=замените-на-надёжный-пароль
